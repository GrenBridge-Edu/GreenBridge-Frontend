VITE_API_BASE_URL=/api
VITE_VAPID_PUBLIC_KEY=

# Vercel Routing Middleware (middleware.ts) — SEO tag injection for /program/:slug, plus
# /sitemap.xml and /robots.txt. Server-side only (read via process.env, not import.meta.env), so
# it must be set as a Vercel Project env var (Production + Preview), NOT here in a client .env
# file. Use the SAME absolute backend URL that VITE_API_BASE_URL resolves to in production —
# e.g. https://api.greenbridge.com/api — not the "/api" local dev-proxy value above.
# If unset, middleware.ts skips tag injection and falls through to the plain SPA shell/sitemap
# stays empty of program — nothing breaks, but crawlers see generic tags until it's set.
SEO_API_BASE_URL=
